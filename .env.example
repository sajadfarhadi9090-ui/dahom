# ============================================================
# .env.example — کپی کنید به .env و مقادیر را پر کنید
# cp .env.example .env
# ============================================================

# امنیت: یک رشتهٔ تصادفی طولانی — حتماً عوض کنید
# ساخت:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# رمز ورود پنل مدیریت (پیش‌فرض dahom123)
ADMIN_PASSWORD=dahom123

# مسیر پنل مدیریت (پیش‌فرض: panel → آدرس /panel)
ADMIN_PANEL_PATH=panel

# پورت سرور (در Render/Liara/Railway خودکار ست می‌شود)
PORT=5000

# مسیر داده‌ها (دیتابیس + آپلودها) — در هاست به دیسک پایدار بدهید
# مثال VPS:  DATA_DIR=/opt/dahom
# مثال Render: DATA_DIR=/opt/render/project/src/data
DATA_DIR=

# اگر پشت HTTPS هستید (nginx با ssl) = 1 بگذارید
COOKIE_SECURE=0

# ---------- زرین‌پال ----------
# مرچنت‌کد درگاه: از پنل زرین‌پال (https://zarinpal.com) بگیرید
# برای تست می‌توانید از سندباکس استفاده کنید
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1   # 1 = درگاه تست (سندباکس) ، 0 = درگاه واقعی
